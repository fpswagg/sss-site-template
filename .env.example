# ── Which SSS business this site shows ──────────────────────────────────────
# The business slug (the part after /b/ in its SSS public page link).
# Leave empty to run on built-in demo data.
SSS_STORE_SLUG=

# SSS API origin. Default: the production SSS API.
SSS_API_URL=https://sss-api.fpswagg.site

# ── Optional ────────────────────────────────────────────────────────────────
# Seconds the SSS data is cached before it is fetched again (default 300).
SSS_REVALIDATE=300

# Secret for POST /api/revalidate?secret=… (refresh the cache right after editing in SSS).
REVALIDATE_SECRET=

# Public URL of this site (sitemap, canonical links, social cards).
SITE_URL=http://localhost:3000

# Use another customer-assistant key than the one SSS publishes with the showcase
# (cb_…, from SSS → Customer bot → Website). Normally leave empty.
SSS_BOT_KEY=
