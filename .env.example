# ── Which SSS business this site shows ──────────────────────────────────────
# The business slug (the part after /b/ in its SSS public page link).
# Leave empty to run on built-in demo data.
SSS_STORE_SLUG=

# SSS API origin. Default: the production SSS API.
SSS_API_URL=https://sss-api.fpswagg.site

# ── Optional ────────────────────────────────────────────────────────────────
# Seconds the SSS data is cached before it is fetched again (default 300).
SSS_REVALIDATE=300

# Secret for POST /api/revalidate?secret=… (refresh the cache right after editing in SSS).
REVALIDATE_SECRET=

# Public URL of this site (sitemap, canonical links, social cards).
SITE_URL=http://localhost:3000

# Business API key (sss_…, from SSS → Business → API). Only needed to read the
# business's STYLE.md (getStyle() / {{style}} in markdown pages). It gives owner-level
# access to that business: server-only, never put it in client code.
SSS_API_KEY=

# Use another customer-assistant key than the one SSS publishes with the showcase
# (cb_…, from SSS → Customer bot → Website). Normally leave empty.
SSS_BOT_KEY=

# ── Sign in with SSS (optional) ─────────────────────────────────────────────
# Lets visitors sign in with their SSS account (OAuth 2.0). Register the site in
# SSS → Business → API → Sign in with SSS, as a server app, with the redirect URL
#   {SITE_URL}/auth/sss/callback
# then paste its client id and secret. See docs/oauth.md. Empty = off.
SSS_OAUTH_CLIENT_ID=
SSS_OAUTH_CLIENT_SECRET=
SSS_OAUTH_SCOPE=profile email
# Signs the sign-in cookies. Generate one: openssl rand -hex 32
SESSION_SECRET=
